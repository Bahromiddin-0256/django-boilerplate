{
  "dashboard": {
    "id": null,
    "uid": "django-logs",
    "title": "Django Application Logs",
    "tags": ["django", "logs"],
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Request Logs",
        "type": "logs",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "datasource": {"type": "loki", "uid": "${datasource}"},
        "targets": [
          {
            "expr": "{job=\"containerlogs\", container_name=~\".*web.*\"} | json | line_format \"{{.message}}\"",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 2,
        "title": "Celery Task Logs",
        "type": "logs",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "datasource": {"type": "loki", "uid": "${datasource}"},
        "targets": [
          {
            "expr": "{job=\"containerlogs\", container_name=~\".*celery.*\"} | json | line_format \"{{.message}}\"",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 3,
        "title": "Error Logs",
        "type": "logs",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "datasource": {"type": "loki", "uid": "${datasource}"},
        "targets": [
          {
            "expr": "{job=\"containerlogs\"} | json | level=\"ERROR\" | line_format \"{{.message}}\"",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending"
        }
      }
    ]
  },
  "overwrite": true
}
